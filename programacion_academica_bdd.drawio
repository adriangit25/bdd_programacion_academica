        ══════════════════════════════════ -->
        <mxCell id="n38501" value="ISO/IEC TS 38501&#xa;Guía de Implementación&#xa;(2015)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#5B21B6;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;" parent="1" vertex="1">
