        </mxCell>
        <mxCell id="d385051" value="❌ DESVENTAJAS&#xa;• Enfocada en datos, no en TI general&#xa;• Requiere madurez previa en 38500&#xa;• Implementación costosa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
