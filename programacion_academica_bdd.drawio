        <mxCell id="v385051" value="✅ VENTAJAS&#xa;• Aplica principios 38500 a datos&#xa;• Cubre calidad, privacidad y ética de datos&#xa;• Alineado con GDPR y regulaciones&#xa;• Relevante para economía digital" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
