        <mxCell id="n385051" value="ISO/IEC 38505-1&#xa;Gobernanza de Datos — Parte 1&#xa;(2017)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DB2777;strokeColor=#BE185D;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;" parent="1" vertex="1">
