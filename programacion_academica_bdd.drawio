        <mxCell id="v38504" value="✅ VENTAJAS&#xa;• Explica cómo estructurar normas de gobernanza&#xa;• Facilita creación de normas derivadas&#xa;• Asegura coherencia en la familia 38500" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
