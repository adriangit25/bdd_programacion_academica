        <mxCell id="v38507" value="✅ VENTAJAS&#xa;• Primera norma de gobernanza de IA&#xa;• Aborda ética, transparencia y riesgo de IA&#xa;• Muy relevante para 2026 y futuro&#xa;• Complementa ISO/IEC 22989 (IA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
