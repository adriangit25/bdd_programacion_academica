        <!-- Ventajas 38500 -->
        <mxCell id="v38500" value="✅ VENTAJAS&#xa;• Principios universales aplicables a cualquier sector&#xa;• Alinea TI con estrategia corporativa&#xa;• Reduce riesgos operativos y financieros&#xa;• Reconocida internacionalmente&#xa;• Complementa COBIT e ITIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="960" y="90" width="290" height="110" as="geometry"/>
        </mxCell>
        <!-- Desventajas 38500 -->
        <mxCell id="d38500" value="❌ DESVENTAJAS&#xa;• No especifica procesos operativos&#xa;• Requiere interpretación para implementar&#xa;• No es certificable formalmente&#xa;• Muy genérica para guía técnica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
