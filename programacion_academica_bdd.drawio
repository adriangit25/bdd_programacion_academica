        </mxCell>
        <mxCell id="d38502" value="❌ DESVENTAJAS&#xa;• Solo es informe técnico (TR)&#xa;• Muy conceptual, poca guía operativa&#xa;• Requiere conocimiento previo de 38500" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
