        </mxCell>
        <mxCell id="v38501" value="✅ VENTAJAS&#xa;• Guía práctica para implementar 38500&#xa;• Define roles y responsabilidades claros&#xa;• Identifica factores internos y externos&#xa;• Reduce curva de aprendizaje" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="120" y="290" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="d38501" value="❌ DESVENTAJAS&#xa;• Solo es especificación técnica (TS)&#xa;• No reemplaza consultoría especializada&#xa;• Orientada a grandes organizaciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="120" y="400" width="270" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="a38501" value="🏛 APLICACIÓN&#xa;• Diseño inicial del sistema de gobernanza&#xa;• Empresas que adoptan 38500 por primera vez&#xa;• Consultoras de TI y auditores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
